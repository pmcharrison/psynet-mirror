// Note: if you are making modifications to this file, consider also propagating these
// changes to psynet/resources/experiment_scripts/.devcontainer/devcontainer.json,
// which is used as a template for demo experiments.
{
    "build": { "dockerfile": "../Dockerfile" },
    "features": {
        "ghcr.io/devcontainers/features/docker-in-docker:2": {}
    },
    "extensions": [
        "ms-python.python",
        "ms-python.isort",
        "ms-python.black-formatter",
        "ms-python.flake8",
        "ms-ossdata.vscode-pgsql",
        "mtxr.sqltools",
        "mtxr.sqltools-driver-pg"
    ],
    "mounts": [
        "source=${localEnv:HOME}/psynet-data,target=/root/psynet-data,type=bind",
        "source=${localEnv:HOME}/.ssh,target=/root/.ssh,type=bind"
    ],
    "postCreateCommand": "bash .devcontainer/postcreate.sh",
    "postAttachCommand": "bash .devcontainer/postattach.sh",
    "settings": {
        "[python]": {
            "editor.defaultFormatter": "ms-python.black-formatter",
            "editor.formatOnSave": true,
            "editor.codeActionsOnSave": {
                "source.organizeImports": "explicit"
            }
        },
        "isort.args":["--profile", "black"],
        "sqltools.connections": [
            {
                "ssh": "Disabled",
                "previewLimit": 50,
                "server": "localhost",
                "port": 5432,
                "driver": "PostgreSQL",
                "name": "dallinger",
                "database": "dallinger",
                "username": "dallinger",
                "password": "dallinger"
            }
        ]
    }
}
