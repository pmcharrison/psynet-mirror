#!/bin/bash

# Builds the experiment Docker image

if [ -e deploy.toml ] || [ -L deploy.toml ]; then
  echo "ERROR: docker/build does not honor deploy.toml and cannot safely build this experiment." >&2
  echo "Use the standard PsyNet/Dallinger commands so every backend uses the reviewed deployment plan." >&2
  exit 1
fi

. docker/params

echo "Building the experiment's Docker image and tagging it $EXPERIMENT_IMAGE..."


DOCKER_SCAN_SUGGEST=false DOCKER_BUILDKIT=1 \
  docker build \
  --build-arg PSYNET_DEVELOPER_MODE="${PSYNET_DEVELOPER_MODE-}" \
  --progress=plain \
  -t "${EXPERIMENT_IMAGE}" \
  .

echo "Finished building Docker image."
