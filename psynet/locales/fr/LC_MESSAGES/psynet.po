msgctxt "language-select"
msgid "Please list at least one language!"
msgstr "Veuillez lister au moins une langue !"

#: psynet/demography/general.py
msgctxt "language-select"
msgid ""
"Please list the languages you speak in order of proficiency (first language "
"first, second language second, ...)"
msgstr ""
"Veuillez lister les langues que vous parlez par ordre de compétence "
"(première langue en premier, deuxième langue en second, ...)"

#: psynet/demography/general.py
msgctxt "language-select"
msgid "Select a language"
msgstr "Sélectionnez une langue"

#: psynet/demography/general.py
msgctxt "language-select"
msgid ""
"What is your mother tongue - i.e., the language which you have grown up "
"speaking from early childhood?"
msgstr ""
"Quelle est votre langue maternelle - c'est-à-dire la langue que vous parlez "
"depuis votre petite enfance ?"

#: psynet/demography/general.py
msgctxt "language-select"
msgid "You need to select a language!"
msgstr "Vous devez sélectionner une langue !"

#: psynet/demography/general.py
msgctxt "music"
msgid "Do you have hearing loss or any other hearing issues?"
msgstr ""
"Souffrez-vous d'une perte d'audition ou de touts autres problèmes auditifs ?"

#: psynet/demography/general.py
msgctxt "music"
msgid "Do you make money from playing music?"
msgstr "Gagnez-vous de l'argent en jouant de la musique ?"

#: psynet/demography/general.py
msgctxt "music"
msgid "Frequently"
msgstr "Fréquemment"

#: psynet/demography/general.py
msgctxt "music"
msgid ""
"How many years of formal training on a musical instrument (including voice) "
"have you had during your lifetime?"
msgstr ""
"Combien d'années de formation formelle sur un instrument de musique (y "
"compris la voix) avez-vous eu au cours de votre vie ?"

#: psynet/demography/general.py
msgctxt "music"
msgid "Never"
msgstr "Jamais"

#: psynet/demography/general.py
msgctxt "music"
msgid "On average, how many hours do you listen to music daily?"
msgstr "En moyenne, combien d'heures écoutez-vous de la musique par jour ?"

#: psynet/demography/general.py
msgctxt "music"
msgid "Sometimes"
msgstr "De temps en temps"

#: psynet/demography/general.py
msgctxt "speech-disorder"
msgid "Did you get speech-language therapy as a child?"
msgstr "Avez-vous suivi une thérapie orthophonique pendant votre enfance ?"

#: psynet/demography/general.py
msgctxt "speech-disorder"
msgid "Have you ever been diagnosed with dyslexia?"
msgstr "Avez-vous reçu un diagnostic de dyslexie ?"

