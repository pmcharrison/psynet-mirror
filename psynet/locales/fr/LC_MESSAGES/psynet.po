#: psynet/demography/general.py
msgctxt "experiment-feedback"
msgid "Did you encounter any technical problems during the experiment?"
msgstr ""
"Avez-vous rencontré des problèmes techniques pendant cette expérience?"

#: psynet/demography/general.py
msgctxt "experiment-feedback"
msgid "Did you find the experiment difficult?"
msgstr "Avez-vous trouvé cette expérience difficile ?"

