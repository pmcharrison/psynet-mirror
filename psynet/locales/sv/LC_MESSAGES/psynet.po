msgstr ""
"En hög avklingningsparameter innebär att det tar lång tid för signalen att "
"avklinga (dvs. hög utjämning)."

#: psynet/templates/macros/control.html
#, fuzzy
msgctxt "audio_meter_calibrate"
msgid "Documentation"
msgstr "Dokumentation"

