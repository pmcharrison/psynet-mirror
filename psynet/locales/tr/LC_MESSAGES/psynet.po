"Ödüllendirilmek için <strong> en az "
"%(currency)s%(MIN_ACCUMULATED_BONUS_FOR_ABORT)s</strong> bonus kazanmanız "
"gerekmektedir."

#: psynet/templates/abort_not_possible.html:40
msgctxt "abort_possible"
msgid "See below information on your currently accumulated bonus."
msgstr ""
