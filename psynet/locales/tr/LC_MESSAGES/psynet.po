#: psynet/templates/abort_not_possible.html:34
msgctxt "abort_possible"
msgid "Aborting not possible."
msgstr "İptal etmek mümkün değil."

#: psynet/templates/abort_not_possible.html:37
msgctxt "abort_possible"
msgid ""
"Aborting the experiment is not possible as the experimenter does not allow "
"it at this time!"
msgstr ""
"Deneyi iptal etmek mümkün değil çünkü deneyci şu anda buna izin vermiyor!"

