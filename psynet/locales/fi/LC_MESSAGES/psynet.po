#: psynet/lucid/qualifications/__init__.py
#, fuzzy
msgctxt "lucid_qualifications_timeout"
msgid ""
"This survey requires you to stay on the website. When you switch tabs or "
"leave the window, your participation will be terminated earlier. If you wish"
" to end the survey earlier, please press the \"early termination\" button "
"provided on each survey page. Please note that early termination will not "
"result in compensation."
msgstr ""
"Tämä kysely edellyttää, että pysyt verkkosivustolla. Kun vaihdat välilehteä "
"tai poistut ikkunasta, osallistumisesi päättyy aikaisemmin. Jos haluat "
"lopettaa kyselyn aikaisemmin, paina jokaisella kyselysivulla olevaa "
"\"ennenaikainen lopettaminen\" -painiketta. Huomaa, että ennenaikainen "
"lopettaminen ei johda korvaukseen."

