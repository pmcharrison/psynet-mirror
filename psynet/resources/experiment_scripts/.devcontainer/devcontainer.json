// Note: if you are making modifications to this file, consider also proposing
// corresponding changes to the .devcontainer/devcontainer.json file in the
// root of the PsyNet package's repository, which is used to define the
// development environment for PsyNet source code.
{
    "build": { "dockerfile": "../Dockerfile" },
    "features": {
        "ghcr.io/devcontainers/features/docker-in-docker:2": {}
    },
    "mounts": [
        "source=${localEnv:HOME}/psynet-data,target=/root/psynet-data,type=bind",
        "source=${localEnv:HOME}/.ssh,target=/root/.ssh,type=bind"
    ],
    "postCreateCommand": "bash .devcontainer/postcreate.sh",
    "postAttachCommand": "bash .devcontainer/postattach.sh"
}
