[Parameters]
aws_region = us-east-1

[Launch mode]
mode = live

[Payment information]
title = Sound game: play with sounds (Chrome browser, Headphones required ~2 min, bonus ~ $0.35)
base_payment = 0.10

[Recruitment strategy]
recruiter = mturk
auto_recruit = false
lifetime = 24
duration = 0.25
us_only = true
approve_requirement = 99
ad_group = FrankTest
assign_qualifications = true
browser_exclude_rule = MSIE, mobile, tablet
disable_when_duration_exceeded = False

[Ad metadata]
description = A short sound game. Requires a Chrome browser and headphones. The game lasts approximately 2 minutes with a bonus of ~ $0.35.
keywords = music, sounds
contact_email_on_error = computational.audition+online_running_nori@gmail.com
organization_name = Max Planck Institute for Empirical Aesthetics

[Database]
database_size = standard-2

[Server]
# Dyno types: hobby, standard-1x, standard-2x, performance-m, performance-l, probably performance-m is best
dyno_type = performance-m
num_dynos_web = 2
num_dynos_worker = 1
redis_size = hobby-dev
host = 0.0.0.0
clock_on = true
